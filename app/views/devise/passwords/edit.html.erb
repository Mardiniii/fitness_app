<% content_for :title, t("devise.passwords.edit.change_your_password") %>

<div class="mx-auto max-w-sm py-6">
  <h1 class="display text-[22px]"><%= t("devise.passwords.edit.change_your_password") %></h1>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
               html: { method: :put, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, t("devise.passwords.edit.new_password"), class: "field-label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: "field" %>
      <% if @minimum_password_length %>
        <p class="cue mt-1"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "field-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "field" %>
    </div>

    <%= f.submit t("devise.passwords.edit.change_my_password"), class: "btn btn-now w-full" %>
  <% end %>
</div>
