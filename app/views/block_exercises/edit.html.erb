<% content_for :title, @block_exercise.exercise.name_es %>
<% sets = @block_exercise.sets_by_number %>
<% first = sets.first&.first %>
<% varied = sets.map { |g| g.first.slice("reps_min", "reps_max", "load_value", "target_rpe") }.uniq.size > 1 %>
<% has_drop = @block_exercise.prescribed_sets.any? { |s| s.segment_number > 1 } %>

<nav class="u-label text-ink-soft">
  <%= link_to @day.program_week.program_version.program.name,
        @day.program_week.program_version.program, class: "hover:text-now" %>
  <span class="text-ink-faint">/</span>
  <%= link_to @day.display_name, program_day_path(@day), class: "hover:text-now" %>
</nav>

<h1 class="display mt-1 text-[26px]"><%= @block_exercise.exercise.name_es %></h1>
<p class="cue"><%= @block_exercise.program_block.name %></p>

<%= form_with url: block_exercise_path(@block_exercise), method: :patch, class: "mt-6 space-y-6" do %>

  <section class="card p-4">
    <div class="grid gap-3 sm:grid-cols-12">
      <div class="sm:col-span-3">
        <label class="field-label"><%= t(".set_count") %></label>
        <%= number_field_tag :set_count, @block_exercise.prescribed_sets.map(&:set_number).uniq.size.clamp(1, 20),
              min: 1, max: 20, class: "field-num py-1 text-[16px]" %>
      </div>

      <div class="sm:col-span-5">
        <label class="field-label"><%= t(".mode") %></label>
        <div class="flex gap-3 pt-1">
          <label class="flex items-center gap-1.5 text-[13px] font-semibold">
            <%= radio_button_tag :mode, "uniform", !varied, class: "size-4 border-2 border-ink text-now focus:ring-0" %>
            <%= t(".mode_uniform") %>
          </label>
          <label class="flex items-center gap-1.5 text-[13px] font-semibold">
            <%= radio_button_tag :mode, "per_set", varied, class: "size-4 border-2 border-ink text-now focus:ring-0" %>
            <%= t(".mode_per_set") %>
          </label>
        </div>
      </div>

      <div class="sm:col-span-4">
        <label class="field-label"><%= t(".per_side") %></label>
        <label class="flex items-center gap-1.5 pt-1 text-[13px] font-semibold">
          <%= check_box_tag "block_exercise[per_side]", "1", @block_exercise.per_side?,
                class: "size-4 rounded-[3px] border-2 border-ink text-now focus:ring-0" %>
          <%= t(".per_side_hint") %>
        </label>
      </div>
    </div>

    <p class="cue mt-3"><%= t(".mode_hint") %></p>
  </section>

  <section class="card p-4">
    <h2 class="u-label mb-3 text-ink-soft"><%= t(".uniform_title") %></h2>
    <%= render "set_fields", prefix: "uniform", set: first, show_drop: false, show_time: true %>
  </section>

  <section class="card p-4">
    <h2 class="u-label mb-3 text-ink-soft"><%= t(".per_set_title") %></h2>
    <div class="space-y-4">
      <% (sets.presence || [ [ nil ] ]).each_with_index do |segments, i| %>
        <div class="rounded-brand border border-line p-3">
          <div class="mb-2 flex items-center gap-2">
            <span class="chip chip-now w-16 shrink-0"><%= t(".set_n", n: i + 1) %></span>
            <% if segments.size > 1 %>
              <span class="stat-k text-done"><%= t(".has_drop") %></span>
            <% end %>
          </div>
          <%= render "set_fields", prefix: "sets[#{i}]", set: segments.first,
                     show_drop: true, show_time: true %>
        </div>
      <% end %>
    </div>
    <p class="cue mt-3"><%= t(".per_set_hint") %></p>
  </section>

  <section class="card p-4">
    <h2 class="u-label mb-2 text-ink-soft"><%= t(".technique") %></h2>
    <%= text_area_tag "block_exercise[technique_notes]", @block_exercise.technique_notes,
          rows: 2, class: "field", placeholder: t(".technique_placeholder") %>
  </section>

  <div class="flex gap-3">
    <%= submit_tag t(".save"), class: "btn btn-now tap" %>
    <%= link_to t(".cancel"), program_day_path(@day), class: "btn btn-quiet tap" %>
  </div>
<% end %>

<%# Alternatives live outside the form above: each control renders its own form. %>
<section class="card mt-6 p-4">
  <h2 class="u-label text-ink-soft"><%= t(".alternatives") %></h2>
  <p class="cue mt-1"><%= t(".alternatives_hint") %></p>

  <% if @block_exercise.block_exercise_alternatives.any? %>
    <ul class="mt-3 divide-y divide-line">
      <% @block_exercise.block_exercise_alternatives.includes(:exercise).order(:position).each do |alt| %>
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="text-[13.5px] font-bold"><%= alt.exercise.name_es %></span>
          <%= button_to t(".remove"), block_exercise_alternative_path(alt), method: :delete,
                class: "btn btn-quiet btn-sm" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: block_exercise_alternatives_path(@block_exercise), method: :post,
                class: "mt-3 flex flex-wrap items-center gap-2" do %>
    <%= select_tag :exercise_id,
          options_from_collection_for_select(@library, :id, :name_es),
          include_blank: t("program_days.show.pick_exercise"),
          class: "field flex-1 min-w-[14rem] py-1.5 text-[13px]" %>
    <%= submit_tag t(".add_alternative"), class: "btn btn-ink btn-sm tap" %>
  <% end %>
</section>
