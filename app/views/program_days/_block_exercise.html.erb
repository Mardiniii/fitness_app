<li class="border-t border-line px-3 py-2">
  <div class="flex flex-wrap items-start gap-2">
    <span class="stat-k mt-1 w-5 shrink-0"><%= block_exercise.position %></span>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[13.5px] font-bold"><%= block_exercise.exercise.name_es %></span>
        <% if block_exercise.per_side? %>
          <span class="stat-k text-ink-soft"><%= t("program_days.show.per_side") %></span>
        <% end %>
        <% if block_exercise.exercise.video? %>
          <span class="stat-k text-ink-faint">▶</span>
        <% end %>
      </div>

      <%# Prescription summary. 2d turns this into a real editor. %>
      <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
        <% block_exercise.sets_by_number.each do |segments| %>
          <span class="rounded-brand border border-line px-1.5 py-0.5 text-[11px] tabular-nums">
            <%= segments.map { |s| [ s.prescription_summary, s.load_summary ].compact.join(" · ") }.join(" + ") %>
            <% if segments.first.target_rpe %>
              <span class="text-now">RPE <%= segments.first.target_rpe.to_s.sub(/\.0$/, "") %></span>
            <% end %>
          </span>
        <% end %>
        <% if (rest = block_exercise.prescribed_sets.first&.rest_seconds) %>
          <span class="stat-k text-ink-faint"><%= t("program_days.show.rest", n: rest) %></span>
        <% end %>
      </div>

      <% if block_exercise.technique_notes.present? %>
        <p class="cue mt-1"><%= block_exercise.technique_notes %></p>
      <% end %>
    </div>

    <% if editable %>
      <div class="flex shrink-0 gap-1">
        <%= link_to t("program_days.show.edit_sets"), edit_block_exercise_path(block_exercise),
              class: "btn btn-ink btn-sm" %>
        <%= button_to "↑", move_block_exercise_path(block_exercise, direction: "up"),
              method: :post, class: "btn btn-quiet btn-sm" %>
        <%= button_to "↓", move_block_exercise_path(block_exercise, direction: "down"),
              method: :post, class: "btn btn-quiet btn-sm" %>
        <%= button_to t("program_days.show.remove"), block_exercise_path(block_exercise),
              method: :delete, class: "btn btn-quiet btn-sm" %>
      </div>
    <% end %>
  </div>
</li>
