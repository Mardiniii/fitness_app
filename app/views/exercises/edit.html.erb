<% content_for :title, @exercise.name_es %>
<div class="flex items-center gap-3">
  <h1 class="display text-[26px]"><%= @exercise.name_es %></h1>
  <% if @exercise.taxonomy_confirmed? %>
    <span class="stat-k text-done"><%= t("exercises.index.confirmed") %></span>
  <% else %>
    <span class="stat-k text-now"><%= t("exercises.index.pending") %></span>
  <% end %>
</div>
<% if @exercise.video? %>
  <div class="mt-6 max-w-md">
    <div class="u-label mb-2 text-ink-soft"><%= t("exercises.video.title") %></div>
    <%= render "shared/video", video: @exercise.video, title: @exercise.name_es %>
  </div>
<% end %>

<%= render "form", exercise: @exercise %>
