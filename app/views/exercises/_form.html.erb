<%= form_with model: exercise, class: "mt-6 max-w-2xl space-y-5" do |f| %>
  <% if exercise.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <ul class="space-y-1">
        <% exercise.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :name_es, class: "field-label" %>
      <%= f.text_field :name_es, class: "field", autofocus: true %>
    </div>
    <div>
      <%= f.label :name_en, class: "field-label" %>
      <%= f.text_field :name_en, class: "field" %>
    </div>
  </div>

  <fieldset class="rounded-brand border-2 border-line p-4">
    <legend class="u-label px-1 text-ink-soft"><%= t(".taxonomy") %></legend>
    <p class="cue mb-3"><%= t(".taxonomy_hint") %></p>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :muscle_region, class: "field-label" %>
        <%= f.select :muscle_region,
              Exercise.muscle_regions.keys.map { |v| [ enum_label("muscle_region", v), v ] },
              { include_blank: true }, class: "field" %>
      </div>
      <div>
        <%= f.label :movement_structure, class: "field-label" %>
        <%= f.select :movement_structure,
              Exercise.movement_structures.keys.map { |v| [ enum_label("movement_structure", v), v ] },
              { include_blank: true }, class: "field" %>
      </div>
      <div>
        <%= f.label :training_quality, class: "field-label" %>
        <%= f.select :training_quality,
              Exercise.training_qualities.keys.map { |v| [ enum_label("training_quality", v), v ] },
              { include_blank: t(".not_applicable") }, class: "field" %>
      </div>
      <div>
        <%= f.label :training_purpose, class: "field-label" %>
        <%= f.select :training_purpose,
              Exercise.training_purposes.keys.map { |v| [ enum_label("training_purpose", v), v ] },
              { include_blank: t(".not_applicable") }, class: "field" %>
      </div>
    </div>
  </fieldset>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :default_measure_kind, class: "field-label" %>
      <%= f.select :default_measure_kind,
            Exercise.default_measure_kinds.keys.map { |v| [ enum_label("measure_kind", v), v ] },
            {}, class: "field" %>
    </div>
    <div>
      <%= f.label :default_equipment_item_id, class: "field-label" %>
      <%= f.collection_select :default_equipment_item_id,
            EquipmentItem.order(:name_es), :id, :display_name,
            { include_blank: true }, class: "field" %>
    </div>
  </div>

  <div>
    <%= f.label :technique_notes, class: "field-label" %>
    <%= f.text_area :technique_notes, rows: 2, class: "field",
          placeholder: t(".technique_placeholder") %>
    <p class="cue mt-1"><%= t(".technique_hint") %></p>
  </div>

  <div>
    <%= f.label :reference_url, class: "field-label" %>
    <%= f.url_field :reference_url, class: "field", placeholder: "https://" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit t(".save"), class: "btn btn-now tap" %>
    <%= link_to t(".cancel"), exercises_path, class: "btn btn-quiet tap" %>
    <% if exercise.persisted? %>
      <% deletable = exercise.deletable? %>
      <div class="ml-auto text-right">
        <%= button_to deletable ? t(".delete") : t(".archive"),
              exercise_path(exercise), method: :delete,
              class: "btn btn-quiet btn-sm tap",
              form: { data: { turbo_confirm: deletable ? t(".delete_warn") : t(".archive_warn") } } %>
        <% unless deletable %>
          <p class="cue mt-1 max-w-[34ch]">
            <%= t(".in_use", count: exercise.reference_count) %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
