<%= form_with model: program, class: "mt-6 max-w-xl space-y-4" do |f| %>
  <% if program.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <ul class="space-y-1">
        <% program.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, class: "field", autofocus: true,
          placeholder: t(".name_placeholder") %>
  </div>
  <div>
    <%= f.label :goal, class: "field-label" %>
    <%= f.text_field :goal, class: "field", placeholder: t(".goal_placeholder") %>
  </div>
  <div>
    <%= f.label :description, class: "field-label" %>
    <%= f.text_area :description, rows: 3, class: "field" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit t(".save"), class: "btn btn-now tap" %>
    <%= link_to t(".cancel"), programs_path, class: "btn btn-quiet tap" %>
  </div>
<% end %>
